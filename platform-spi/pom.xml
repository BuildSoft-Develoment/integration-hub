<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.integrationhub</groupId>
        <artifactId>integration-hub-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>platform-spi</artifactId>
    <description>ADR-021: contrato de extension del motor (TaskProvider, ReaderProvider, SourceProvider,
        writers/sinks, config). Es lo UNICO que un vertical necesita del motor para aportar capacidades.
        Hoja: no depende de ninguna implementacion.</description>

    <dependencies>
        <!-- Contrato compartido: la trama de auditoria viaja por el SPI de tareas. -->
        <dependency>
            <groupId>com.integrationhub</groupId>
            <artifactId>platform-contract</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Solo anotaciones CDI/validacion que aparecen en las firmas del contrato. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- Los schemas de configuracion del contrato llevan anotaciones de serializacion. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- Las utilidades de `spi.task.support` traen logica propia (saneo de identificadores SQL,
             coercion de tipos JDBC) y sus pruebas viajan con ellas, no con el modulo que las usa. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>3.2.2</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals><goal>jandex</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
