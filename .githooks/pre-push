#!/bin/sh
# =====================================================================================
# Rechaza empujar DIRECTO a main o develop. La integracion va por pull request.
#
# POR QUE UN HOOK Y NO UNA PROTECCION DE RAMA
# GitHub NO aplica rulesets ni protecciones clasicas en repositorios privados de este
# plan. Comprobado empujando a main a proposito: paso el push directo, y tambien el
# force push. Mientras eso siga asi, este hook es lo unico que PREVIENE de verdad.
#
# Su limite es evidente y conviene tenerlo presente: solo protege las maquinas donde
# esta instalado. Por eso no viaja solo — el job `guard-pull-request` de CI detecta lo
# que se cuele desde una maquina sin hook y lo deja en rojo. Uno previene, el otro
# delata; ninguno de los dos basta por si mismo.
#
# INSTALACION:  npm run hooks:install
#
# SALIDA DE EMERGENCIA (deliberada, no silenciosa):
#   PERMITIR_EMPUJE_DIRECTO=1 git push origin main
# Existe porque un hook que no se puede saltar se acaba desinstalando entero, y eso
# deja la maquina sin ninguna proteccion en vez de sin una.
# =====================================================================================

PROTEGIDAS="refs/heads/main refs/heads/develop"

if [ "${PERMITIR_EMPUJE_DIRECTO:-}" = "1" ]; then
  echo "pre-push: empuje directo PERMITIDO por PERMITIR_EMPUJE_DIRECTO=1." >&2
  echo "          Queda constancia en CI igualmente: el commit saldra sin pull request asociado." >&2
  exit 0
fi

# git entrega por stdin una linea por ref:  <ref local> <sha local> <ref remota> <sha remoto>
while read -r _ref_local _sha_local ref_remota _sha_remoto; do
  [ -n "$ref_remota" ] || continue
  for protegida in $PROTEGIDAS; do
    if [ "$ref_remota" = "$protegida" ]; then
      rama=$(echo "$protegida" | sed 's|refs/heads/||')
      echo "" >&2
      echo "  EMPUJE DIRECTO A '$rama' RECHAZADO" >&2
      echo "" >&2
      echo "  La integracion va por pull request: es donde los cuatro gates de CI se leen" >&2
      echo "  ANTES de integrar, no despues." >&2
      echo "" >&2
      echo "  Mueve el trabajo a una rama y abre el pull request:" >&2
      echo "" >&2
      echo "    git switch -c fix/lo-que-sea" >&2
      echo "    git push -u origin fix/lo-que-sea" >&2
      echo "" >&2
      echo "  Prefijos: feat/ fix/ refactor/ docs/ chore/ test/ perf/  (ver CONTRIBUTING.md)" >&2
      echo "" >&2
      exit 1
    fi
  done
done

exit 0
