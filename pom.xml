<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.integrationhub</groupId>
    <artifactId>integration-hub-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>platform-contract</module>
        <module>platform-spi</module>
        <module>vertical-swift-mt101</module>
        <module>vertical-iso20022</module>
        <module>ejemplos/backend-plugin-sidecar</module>
        <module>platform-app</module>
        <module>audit-consumer</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.37.2</quarkus.platform.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <quarkus-amazon-services.version>3.19.0</quarkus-amazon-services.version>
        <!-- Carril local/CI estable: evita saturar Docker con forks paralelos y deja las pruebas
             de performance fuera salvo que se pidan de forma explicita. -->
        <test.excluded.groups>perf</test.excluded.groups>
        <test.fork.count>1</test.fork.count>
        <test.reuse.forks>true</test.reuse.forks>
        <!-- Memoria del fork de pruebas. Sin esto la JVM usa su maximo por defecto (un cuarto de
             la RAM), que en una maquina de desarrollo sobra y en un runner de CI no: alli el paso
             de instrumentacion de cobertura de Quarkus agota el heap y el fork muere. Surefire lo
             reporta como "error in the forked process" y como que el motor archunit no pudo
             descubrir tests — dos sintomas que no mencionan la memoria por ningun lado. -->
        <test.jvm.args>-Xmx3g</test.jvm.args>
        <!-- Default VACIO a proposito: jacoco:prepare-agent sobreescribe esta propiedad en tiempo
             de ejecucion, y surefire la sustituye tarde con @{argLine}. Sin un valor por defecto,
             los modulos que NO ejecutan prepare-agent recibirian el literal sin resolver y su JVM
             no arrancaria. -->
        <argLine></argLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.amazonservices</groupId>
                <artifactId>quarkus-amazon-services-bom</artifactId>
                <version>${quarkus-amazon-services.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <excludedGroups>${test.excluded.groups}</excludedGroups>
                        <forkCount>${test.fork.count}</forkCount>
                        <argLine>@{argLine} ${test.jvm.args}</argLine>
                        <reuseForks>${test.reuse.forks}</reuseForks>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <excludedGroups>${test.excluded.groups}</excludedGroups>
                        <forkCount>${test.fork.count}</forkCount>
                        <argLine>@{argLine} ${test.jvm.args}</argLine>
                        <reuseForks>${test.reuse.forks}</reuseForks>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>fast-tests</id>
            <properties>
                <!-- Carril rapido: mantiene unitarias/ITs funcionales y saca la matriz multi-BD. -->
                <test.excluded.groups>perf,compat-db</test.excluded.groups>
            </properties>
        </profile>
        <profile>
            <id>compat-db-tests</id>
            <properties>
                <!-- Ejecuta solo la matriz multi-motor: mvn -Pcompat-db-tests test. -->
                <groups>compat-db</groups>
                <test.excluded.groups>perf</test.excluded.groups>
                <!-- Un solo fork, fijado AQUI y no solo en el workflow: con paralelismo los cuatro
                     motores compiten por CPU y memoria y aparecen fallos que no son del codigo
                     (timeouts de arranque, ORA-12514). Medido: -T1C daba 11 errores, forkCount=3
                     daba 3, un unico fork cero. Coincide con el default global, pero atarlo al
                     perfil hace que la garantia viaje con el carril: quien suba el default para
                     acelerar el carril rapido no rompe la matriz sin darse cuenta, y un
                     `mvn -Pcompat-db-tests test` local se comporta como el CI sin recordar el -D. -->
                <test.fork.count>1</test.fork.count>
            </properties>
        </profile>
        <profile>
            <id>all-tests</id>
            <properties>
                <!-- Incluye tambien pruebas perf; reservado para validaciones largas. -->
                <test.excluded.groups></test.excluded.groups>
            </properties>
        </profile>
        <profile>
            <id>native</id>
            <properties>
                <quarkus.native.enabled>true</quarkus.native.enabled>
                <skipITs>false</skipITs>
                <!-- Optimizacion/paridad de imagen nativa (production-grade). NOTA de sintaxis: las properties
                     Maven son <nombre>valor</nombre>; NO <nombre=valor></nombre=valor> (XML invalido). -->
                <!-- Compila en contenedor (Mandrel) para paridad de OS (Linux glibc); antes iba por -D en el script. -->
                <quarkus.native.container-build>true</quarkus.native.container-build>
                <!-- Heap del proceso native-image (Mandrel) dentro del contenedor: NO se fija a proposito.
                     Por defecto native-image usa el 80% de la RAM que ve el contenedor (~9.5G en la VM WSL2 de
                     12G), que es exactamente lo que consumieron los builds exitosos. Fijar por debajo (p.ej. 6G)
                     OOMea en la fase [5/8] analysis de una imagen grande (POI+Azure+gRPC+Kafka+Artemis+Hibernate);
                     fijar por encima no tiene headroom en 12G. Si algun dia se migra a una VM con mas RAM y se
                     quiere acotar, ponerlo aqui explicito >= 9.5G: quarkus.native.native-image-xmx. -->
                <!-- <quarkus.native.native-image-xmx>10g</quarkus.native.native-image-xmx> -->
                <!-- Compresion UPX: nivel 7 (ya afinado en application.properties). El nivel es 0..10; mas alto =
                     imagen menor, build algo mas lento. La property vive en application.properties, no aqui. -->
                <!-- Optimizacion GraalVM: -O2 es el DEFAULT en builds nativos de produccion (no-debug); no hace
                     falta property extra. Para forzarlo explicito: quarkus.native.additional-build-args=-O2
                     (NO existe quarkus.native.optimization-level). -->
                <!-- Limite de hilos del build: se pasa por quarkus.native.additional-build-args (NO
                     quarkus.native.builder-arguments). El flag depende de la version de Mandrel
                     (H:NumberOfThreads=4, o parallelism en GraalVM 23+). Se deja fuera hasta validar el flag
                     exacto contra Mandrel jdk-25: un arg invalido rompe el build de 25 min. -->
            </properties>
        </profile>
        <!-- Deploy bajo el subpath /appih (integracion detras de nginx). Hornea el
             base-href del SPA (config 'appih' del build de Nx via Quinoa) + el root-path
             de Quarkus. Opt-in: solo activo con -Pappih; dev/prod normal quedan en /. -->
        <profile>
            <id>appih</id>
            <properties>
                <quarkus.http.root-path>/appih</quarkus.http.root-path>
                <quarkus.quinoa.package-manager-command.build>run build:appih</quarkus.quinoa.package-manager-command.build>
            </properties>
        </profile>
    </profiles>
</project>
