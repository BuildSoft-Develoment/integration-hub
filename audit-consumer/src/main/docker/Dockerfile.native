# Imagen NATIVA del audit-consumer (deployable independiente). Espera el binario ya
# construido en target/*-runner:
#   mvn -pl audit-consumer -am package -Pnative -Dquarkus.native.container-build=true
#
# Runtime UBI9 (glibc 2.34): debe emparejar con el builder Mandrel jdk-25 (ubi9). La
# variante quarkus-micro-image:2.0 es UBI8 (glibc 2.28) y el runner no arranca.
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0

WORKDIR /work/
RUN chown 1001 /work && chmod g+rwX /work && chown 1001:root /work

ARG RUNNER=target/*-runner
COPY --chown=1001:root --chmod=0755 ${RUNNER} /work/application

EXPOSE 8082
USER 1001

# Health: /q/health/live y /q/health/ready (quarkus-smallrye-health).
ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0", "-Dquarkus.http.port=8082"]
