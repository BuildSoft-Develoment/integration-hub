<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.integrationhub</groupId>
        <artifactId>integration-hub-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>vertical-swift-mt101</artifactId>
    <description>ADR-021: vertical SWIFT MT101 como modulo propio (monolito modular: mismo deployable).</description>

    <dependencies>
        <!-- Contrato compartido (trama de auditoria). Es la dependencia PERMITIDA hacia la plataforma. -->
        <dependency>
            <groupId>com.integrationhub</groupId>
            <artifactId>platform-contract</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- ADR-021: el contrato del motor. Es lo unico que el vertical necesita para aportar
             sus capacidades (TaskProvider, readers, writers, sinks, config). -->
        <dependency>
            <groupId>com.integrationhub</groupId>
            <artifactId>platform-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- Reglas de validacion con expresiones (ADR-018). -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-jexl3</artifactId>
            <version>3.4.0</version>
        </dependency>
        <!-- El gateway de STATUS del banco consulta por SFTP. -->
        <dependency>
            <groupId>io.quarkiverse.jsch</groupId>
            <artifactId>quarkus-jsch</artifactId>
            <version>3.2.0</version>
        </dependency>
        <!-- Los repositorios del vertical son JDBC crudo (ADR-011) y serializan config con Jackson. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <!-- ADR-020: la planilla de correccion la ESCRIBE el writer XLSX del motor (via el SPI), pero
             LEERLA es responsabilidad propia del vertical: es auto-descriptiva (el header nombra las
             columnas dinamicas), asi que no sirve el reader posicional generico. De ahi POI directo. -->
        <dependency>
            <groupId>io.quarkiverse.poi</groupId>
            <artifactId>quarkus-poi</artifactId>
            <version>2.2.1</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5-mockito</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Las pruebas del vertical viajan CON el vertical (ADR-021): son suyas, no del motor.
             Ninguna es @QuarkusTest — son unitarias con dobles a mano — pero las del money-path
             levantan Postgres real (testcontainers) y un banco falso por HTTP (WireMock) porque
             probar el envio contra mocks de driver no probaria nada. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock</artifactId>
            <version>3.9.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Quarkus solo descubre beans CDI de una dependencia si trae indice Jandex. -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>3.2.2</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals><goal>jandex</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
