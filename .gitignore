# ───────────────────────────────────────────────────────────────────────────
# Framework AI-first empresarial (capa operativa instanciada desde el template).
# ───────────────────────────────────────────────────────────────────────────
# Temporales / backups locales
*.tmp
*.bak
*.old
*~
.tmp/

# Bundles distribuibles regenerables
dist/
# ...pero el dist de DESPLIEGUE (config/IaC/Helm por entorno) SI se versiona: es fuente,
# no build output. Se des-ignora explicitamente (su parent no esta excluido, asi que la
# negacion del directorio basta para re-incluir su contenido).
!ops/fase-7-deploy/dist/
# ...salvo los .env reales con secretos (los .env.example SI se versionan).
ops/fase-7-deploy/dist/**/.env

# Evidencia local regenerable / sensible de Lighthouse y sesiones browser
lighthouse-report/
lighthouse-bearer.txt
lighthouse-cookies.txt
lighthouse-headers.json

# git worktrees creados por agent:start (sandboxes locales por T-NNN)
worktrees/
.worktrees/
**/worktrees/

# Memoria local del agente IA (regenerable con memory:bootstrap)
ai/memory/*.db
ai/memory/*.sqlite
ai/memory/*.db-*
ai/memory/*.sqlite-*
ai/memory/memory-report.html

# Directorio de agente interno por proyecto real
.agent/*.db
.agent/*.sqlite
.agent/*.db-*
.agent/runs/
ai-framework-*.db
ai-framework-*.sqlite

# Estado del roadmap regenerable con 'npm run roadmap:sync'
ROADMAP_STATE.json

# Orquestacion multiagente (regenerables / volatiles)
ai/locks/
AGENT_BOARD.md

# Artefactos transpilados por 'install:agent --agent claude' / 'skills:transpile'
.claude/skills/
.claude/commands/
.claude/protocols/
.claude/mcp.json
.claude/launch.json
