{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ui-kit-storybook": {
      "projectType": "library",
      "root": "libs/shared/ui",
      "sourceRoot": "libs/shared/ui/src",
      "prefix": "ih",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/ui-kit-storybook-noop",
            "index": ".storybook/index.html",
            "main": ".storybook/noop-main.ts",
            "tsConfig": ".storybook/tsconfig.json",
            "styles": ["apps/web/src/styles.scss"],
            "aot": false,
            "optimization": false,
            "namedChunks": true
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "ui-kit-storybook:build",
            "compodoc": false,
            "port": 4400
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "ui-kit-storybook:build",
            "compodoc": false,
            "outputDir": "dist/storybook"
          }
        }
      }
    }
  }
}
