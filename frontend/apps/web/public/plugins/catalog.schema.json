{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/plugins/catalog.schema.json",
  "title": "Integration Hub frontend plugin catalog",
  "description": "Catalogo de contribuciones de frontend instalables desde fuera. Aporta metadata hacia rutas que el shell YA monta (navigation, workspaces, actions, i18nNamespaces) y, opcionalmente, un bloque `remote` de Native Federation que si carga codigo Angular: solo se monta tras verificar la firma ECDSA P-256, recomputar la integridad SRI del remoteEntry y comprobar que su origen esta en la allowlist (ADR-013); si alguna falla el plugin queda degraded. La url debe ser https, salvo loopback en desarrollo. Lo que un catalogo JSON NO puede es declarar rutas Angular: `routes` esta en maxItems 0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifests"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pluginManifest"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "string",
      "enum": [
        "admin",
        "operate",
        "audit",
        "audit-read",
        "audit-operate",
        "audit-admin"
      ]
    },
    "knownShellRoute": {
      "type": "string",
      "enum": [
        "/audit",
        "/audit/events",
        "/audit/record-lineage",
        "/audit/spool",
        "/connections",
        "/executions",
        "/executions/async-dlq",
        "/overview",
        "/payment-rules",
        "/plugins",
        "/processes",
        "/readers",
        "/schedules",
        "/sources",
        "/swift-mt101",
        "/swift-mt101/fragments",
        "/swift-mt101/pay-conflicts",
        "/swift-mt101/pay-dispatch",
        "/swift-mt101/quarantine",
        "/ui-kit"
      ],
      "description": "Rutas que el shell monta de verdad. Es el mismo conjunto con el que app-plugin-runtime.registry.ts construye knownStaticRoutes y decide la cuarentena: una ruta que este aqui pero no en el shell hace que el plugin pase el gate y muera en runtime. Lo mantiene alineado ci/scripts/check-shell-routes-sync.mjs."
    },
    "pluginManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "platformVersion",
        "displayName"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "platformVersion": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          },
          "uniqueItems": true
        },
        "i18nNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "navigation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navigationContribution"
          }
        },
        "routes": {
          "type": "array",
          "maxItems": 0,
          "description": "Runtime JSON catalogs are metadata-only. Register Angular routes through a static provider/build artifact."
        },
        "workspaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workspaceContribution"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionContribution"
          }
        },
        "remote": {
          "$ref": "#/$defs/pluginRemote"
        }
      }
    },
    "pluginRemote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "exposedModule",
        "integrity",
        "signature"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "exposedModule": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "sharedDependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "navigationContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route",
        "labelKey"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "$ref": "#/$defs/knownShellRoute"
        },
        "labelKey": {
          "type": "string",
          "minLength": 1
        },
        "requiredCapability": {
          "$ref": "#/$defs/capability"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "number"
        },
        "group": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workspaceContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route",
        "labelKey"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "$ref": "#/$defs/knownShellRoute"
        },
        "labelKey": {
          "type": "string",
          "minLength": 1
        },
        "descriptionKey": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "query",
            "operation",
            "configuration"
          ]
        },
        "order": {
          "type": "number"
        },
        "requiredCapability": {
          "$ref": "#/$defs/capability"
        }
      }
    },
    "actionKind": {
      "type": "string",
      "enum": [
        "command",
        "navigation",
        "external-link"
      ]
    },
    "actionPlacement": {
      "type": "string",
      "enum": [
        "global",
        "workspace",
        "record",
        "toolbar"
      ]
    },
    "actionConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labelKey": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "danger",
            "warning"
          ]
        }
      }
    },
    "actionContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labelKey"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "labelKey": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "number"
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "$ref": "#/$defs/actionPlacement"
        },
        "kind": {
          "$ref": "#/$defs/actionKind"
        },
        "route": {
          "$ref": "#/$defs/knownShellRoute"
        },
        "href": {
          "type": "string",
          "pattern": "^https://"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "requiredCapability": {
          "$ref": "#/$defs/capability"
        },
        "confirmation": {
          "$ref": "#/$defs/actionConfirmation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "navigation"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "route"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "external-link"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "href"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "command"
            ]
          }
        }
      ]
    }
  }
}
