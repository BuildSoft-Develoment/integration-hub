# Azure - variables NO secretas (las secretas vienen de Key Vault via CSI driver).
QUARKUS_PROFILE=prod,azure
DEPLOY_ENV=prod
APP_VERSION=0.0.1

AZURE_STORAGE_ACCOUNT=integrationhubstg
PLUGIN_STAGING_CONTAINER=remote-plugin-staging

DB_JDBC_URL=jdbc:postgresql://<flexible-server>.postgres.database.azure.com:5432/integration_hub
OIDC_AUTH_SERVER_URL=https://<keycloak-o-entra>/realms/integration-hub
OIDC_CLIENT_ID=integration-hub-api
OTEL_OTLP_ENDPOINT=http://otel-collector:4317
# Event Hubs (Kafka-compatible)
KAFKA_BOOTSTRAP_SERVERS=<namespace>.servicebus.windows.net:9093

# --- SECRETOS via Key Vault (CSI): DB_USERNAME / DB_PASSWORD / OIDC_CLIENT_SECRET ---
