# AWS - variables NO secretas (las secretas vienen de Secrets Manager via IRSA/CSI).
# Copiar a .env y ajustar. En EKS estas van al ConfigMap (values env), NO en el repo.
QUARKUS_PROFILE=prod,aws
DEPLOY_ENV=prod
APP_VERSION=0.0.1

AWS_REGION=us-east-1
PLUGIN_STAGING_BUCKET=integration-hub-plugin-staging

# Endpoints gestionados
DB_JDBC_URL=jdbc:postgresql://<rds-endpoint>:5432/integration_hub
OIDC_AUTH_SERVER_URL=https://<keycloak-o-idp>/realms/integration-hub
OIDC_CLIENT_ID=integration-hub-api
OTEL_OTLP_ENDPOINT=http://adot-collector:4317
KAFKA_BOOTSTRAP_SERVERS=<msk-bootstrap>:9098
AUDIT_TOPIC=audit-events

# --- SECRETOS: NO poner valor aqui. Provienen de AWS Secrets Manager ---
# DB_USERNAME / DB_PASSWORD / OIDC_CLIENT_SECRET
