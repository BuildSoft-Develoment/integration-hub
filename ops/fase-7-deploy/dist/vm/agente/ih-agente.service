[Unit]
Description=Agente de despliegue de Integration Hub (ADR-030)
Documentation=file:///home/ndavilal88_gmail_com/integration-hub/ops/fase-7-deploy/dist/vm/agente/README.md
# Sin docker no hay nada que hacer, y sin red no se puede leer la rama de estado.
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot

# CORRE COMO LA PERSONA, NO COMO ROOT. La clave SSH de lectura del repositorio y la pertenencia
# al grupo docker son de este usuario; con root habria que duplicar las dos cosas.
User=ndavilal88_gmail_com
Group=ndavilal88_gmail_com
SupplementaryGroups=docker

ExecStart=/home/ndavilal88_gmail_com/integration-hub/ops/fase-7-deploy/dist/vm/agente/agente.sh /etc/ih-agente.conf

# NO REINTENTAR EN CALIENTE. Si el agente sale mal, el timer lo volvera a intentar en unos
# minutos con el mundo posiblemente distinto. Un Restart=on-failure aqui seria un bucle de
# `docker compose up` contra una maquina que ya esta teniendo un mal dia.
Restart=no

# Tres minutos de espera de salud mas la descarga de dos imagenes. Quince es holgado y sigue
# siendo un techo: un agente colgado no puede quedarse tomado el bloqueo del timer.
TimeoutStartSec=900

# El fichero de constancia vive aqui, y systemd lo crea con el dueno correcto.
StateDirectory=ih-agente

# Endurecimiento razonable para algo que habla con el socket de docker: no puede escalar
# privilegios, no ve /home ajeno, y solo escribe donde tiene que escribir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
