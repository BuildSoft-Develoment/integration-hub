# GCP - variables NO secretas (las secretas vienen de Secret Manager via CSI).
QUARKUS_PROFILE=prod,gcp
DEPLOY_ENV=prod
APP_VERSION=0.0.1

GCP_PROJECT_ID=mi-proyecto
PLUGIN_STAGING_BUCKET=integration-hub-plugin-staging

# Cloud SQL via Auth Proxy sidecar -> 127.0.0.1
DB_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/integration_hub
OIDC_AUTH_SERVER_URL=https://<keycloak-o-identity-platform>/realms/integration-hub
OIDC_CLIENT_ID=integration-hub-api
OTEL_OTLP_ENDPOINT=http://otel-collector:4317
KAFKA_BOOTSTRAP_SERVERS=<kafka-o-pubsub-bridge>:9092

# --- SECRETOS via Secret Manager: DB_USERNAME / DB_PASSWORD / OIDC_CLIENT_SECRET ---
