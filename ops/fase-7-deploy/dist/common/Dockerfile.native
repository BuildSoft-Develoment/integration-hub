# =====================================================================================
# Imagen de RUNTIME nativo (comun a las 5 nubes).
#
# Espera el binario nativo YA construido en platform-app/target/*-runner
# (lo produce `mvnw -Pnative package`, con Quinoa compilando la UI y embebiendola).
# La UI (Quinoa) queda dentro del runner; no hace falta Node en runtime.
#
# Build desde la raiz del repo:
#   docker build -f ops/fase-7-deploy/dist/common/Dockerfile.native \
#     --build-arg RUNNER=platform-app/target/platform-app-0.0.1-SNAPSHOT-runner \
#     -t integration-hub:native .
#
# Los perfiles se activan por env al correr el contenedor:
#   docker run -e QUARKUS_PROFILE=prod,aws --env-file ops/fase-7-deploy/dist/aws/.env ...
# =====================================================================================
# UBI9 (glibc 2.34): debe emparejar con el builder Mandrel jdk-25 (ubi9). La variante
# quarkus-micro-image:2.0 es UBI8 (glibc 2.28) y el runner no arranca (GLIBC_2.34 not found).
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0

WORKDIR /work/
RUN chown 1001 /work && chmod g+rwX /work && chown 1001:root /work

ARG RUNNER=platform-app/target/*-runner
COPY --chown=1001:root --chmod=0755 ${RUNNER} /work/application

# Config externa opcional: si se monta /work/config/application.properties, Quarkus la toma.
ENV QUARKUS_CONFIG_LOCATIONS=/work/config/

EXPOSE 8080
USER 1001

# Health: /q/health/live y /q/health/ready (quarkus-smallrye-health).
ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
