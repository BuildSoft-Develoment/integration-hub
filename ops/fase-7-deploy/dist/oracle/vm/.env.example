# ===== Integration Hub en VM de nube — copiar a .env y rellenar =====
#
# NINGUNA variable de aqui tiene valor por defecto en el compose. Es deliberado: en el
# compose de integracion, POSTGRES_PASSWORD y la del admin de Keycloak caian a "admin" si
# faltaban. En una maquina con IP publica eso es una puerta abierta que nadie recuerda haber
# dejado, porque el arranque no se queja. Aqui, si falta una, el compose no levanta y dice
# cual.
#
# Efecto secundario que conviene conocer: con una sola variable ausente fallan TODOS los
# comandos de compose, incluido `docker compose ps`. Para diagnosticar sin ellas,
# `docker ps` no pasa por el compose y sigue funcionando.

# Nombre publico. Tiene que resolver por DNS a la IP publica de esta VM ANTES de pedir el
# certificado: la CA valida haciendo una peticion HTTP real contra el.
#
# Y tiene que ser un NOMBRE, no una IP: OpenBao habla con Keycloak por su cuenta y exige que
# la URL que usa sea identica al issuer anunciado. nginx lleva este mismo nombre como alias
# de red para que, dentro de la maquina, resuelva al proxy.
PUBLIC_HOST=app.buildsoft.com.pe

# Correo para los avisos de caducidad del certificado. La CA lo exige y es el unico aviso que
# llega si la renovacion automatica deja de funcionar.
CERTBOT_EMAIL=

# Postgres: la usan la plataforma, el consumidor de auditoria y Keycloak (bases separadas,
# mismo servidor). Generar una larga:  openssl rand -base64 32
POSTGRES_PASSWORD=

# Primera cuenta de administrador de Keycloak. SOLO se usa para crearla: en cuanto existe,
# estas variables se ignoran, asi que cambiarlas despues no cambia la contrasena de nadie.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=

# Secreto del cliente `openbao` en Keycloak — el SSO de la consola de secretos.
# Un unico knob para los dos lados: Keycloak lo sustituye al importar el realm, y el mismo
# valor se le pasa a openbao/setup-oidc.sh. Si se desincronizan, el login falla al canjear el
# codigo con "invalid_client", que suena a cliente mal creado y es solo esto.
#   openssl rand -hex 32
OPENBAO_OIDC_CLIENT_SECRET=

# Token con el que la APP lee secretos de OpenBao. NO el token raiz: uno acotado por la
# politica de openbao/policy-integration-hub.hcl (solo lectura de connections/* y tasks/*).
# Se obtiene DESPUES del primer arranque, tras inicializar y desellar OpenBao. Ver el runbook.
OPENBAO_TOKEN=

# Certificado en el que OpenBao confia al hablar con Keycloak. VACIO a proposito: la cadena es
# de una CA publica y le vale el almacen del sistema. Pasarle el certificado HOJA de una cadena
# real haria FALLAR la verificacion, no relajarla. Solo se rellena con certificados autofirmados.
BAO_OIDC_CA_FILE=

# Imagenes nativas aarch64, construidas en esta misma VM con build-native-arm64.sh.
# Las imagenes amd64 del entorno de integracion NO sirven aqui: un binario nativo de GraalVM
# no es portable entre arquitecturas y el contenedor muere con "exec format error".
APP_IMAGE=integration-hub:native-appih-arm64
CONSUMER_IMAGE=integration-hub-audit-consumer:native-arm64
