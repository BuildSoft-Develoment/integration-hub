# Puerto 443: los tres inquilinos. App en /appih, Keycloak en /iam, OpenBao en /ui y /v1.
#
# ES UNA PLANTILLA: init-tls.sh sustituye __PUBLIC_HOST__ y la deja en conf.d/10-https.conf.
# El nombre va escrito en las rutas del certificado, que certbot crea bajo el nombre real; una
# variable de entorno no sirve porque nginx no las interpola en su configuracion.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    http2 on;
    server_name __PUBLIC_HOST__;

    ssl_certificate     /etc/letsencrypt/live/__PUBLIC_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PUBLIC_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Redirecciones RELATIVAS. nginx pega el puerto en el que ESCUCHA a las URLs absolutas que
    # construye; aqui coinciden, pero en el entorno de integracion no —escuchaba en 8443 tras un
    # mapeo 443— y anunciaba un puerto que el router no publicaba: redireccion a la nada, con un
    # timeout por sintoma. Se fija igual en los dos sitios para que no dependa del mapeo.
    absolute_redirect off;

    location = / {
        return 302 /appih/;
    }

    # ---- App ----
    location /appih/ {
        proxy_pass http://platform-app:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }

    # ---- Keycloak ----
    location /iam/ {
        proxy_pass http://keycloak:8180;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
    }

    # ---- OpenBao ----
    #
    # POR QUE SE LLEVA DOS PREFIJOS DE LA RAIZ EN VEZ DE IR BAJO /openbao/ COMO KEYCLOAK EN /iam/
    #
    # Keycloak sabe servirse bajo un prefijo (KC_HTTP_RELATIVE_PATH) y regenera sus URLs. OpenBao
    # no tiene equivalente: su interfaz es una SPA compilada que pide sus activos con ruta
    # ABSOLUTA (/ui/assets/...) y llama a su API en /v1/. Va dentro del HTML que sirve el binario,
    # asi que ninguna opcion de configuracion lo reescribe. Montarlo en /openbao/ dejaria la
    # interfaz cargando y sin poder hablar con su API.
    #
    # ESTOS DOS PREFIJOS QUEDAN RESERVADOS. La app no los usa —verificado: sus rutas absolutas
    # son /appih/—. Si algun dia los necesita, chocaran, y el sintoma sera dificil de leer:
    # peticiones que se van al inquilino equivocado.
    location /ui/ {
        proxy_pass http://openbao:8200/ui/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
    }
    location /v1/ {
        proxy_pass http://openbao:8200/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
    }
    # Atajo memorizable: /openbao lleva a la interfaz real.
    location = /openbao { return 302 /ui/; }
}
