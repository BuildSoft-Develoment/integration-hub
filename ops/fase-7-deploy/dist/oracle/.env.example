# Oracle Cloud (OCI) - variables NO secretas (las secretas vienen de OCI Vault via CSI).
QUARKUS_PROFILE=prod,oracle
DEPLOY_ENV=prod
APP_VERSION=0.0.1

OCI_REGION=us-ashburn-1
OCI_S3_ENDPOINT=https://<namespace>.compat.objectstorage.us-ashburn-1.oraclecloud.com
PLUGIN_STAGING_BUCKET=integration-hub-plugin-staging

DB_JDBC_URL=jdbc:postgresql://<oci-pg-endpoint>:5432/integration_hub
OIDC_AUTH_SERVER_URL=https://<keycloak-o-idcs>/realms/integration-hub
OIDC_CLIENT_ID=integration-hub-api
OTEL_OTLP_ENDPOINT=http://otel-collector:4317
# OCI Streaming (Kafka-compatible)
KAFKA_BOOTSTRAP_SERVERS=cell-1.streaming.us-ashburn-1.oci.oraclecloud.com:9092

# --- SECRETOS via OCI Vault: DB_USERNAME / DB_PASSWORD / OIDC_CLIENT_SECRET ---
