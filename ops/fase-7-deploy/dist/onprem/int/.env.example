# ===== Ambiente de integracion — copiar a .env y ajustar =====

# URL publica base (host que frontea nginx). El issuer de Keycloak y el OIDC de la app
# se derivan de aca. Para test local: dejar el default + agregar al hosts file:
#   127.0.0.1  app.buildsoft.com.pe
PUBLIC_BASE_URL=http://app.buildsoft.com.pe

# Imagen de la app. DEBE estar construida con /appih horneado (ver README > Build).
APP_IMAGE=integration-hub:native-appih

# Postgres
POSTGRES_PASSWORD=admin

# Keycloak admin (consola en http://app.buildsoft.com.pe/iam/admin)
KC_ADMIN_PASSWORD=admin

# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# SFTP fuente (SftpSourceProvider)
SFTP_SOURCE_USER=ihsource
SFTP_SOURCE_PASS=ihsource

# FTP fuente (FtpSourceProvider)
FTP_SOURCE_USER=ihftp
FTP_SOURCE_PASS=ihftp

# SFTP banco (money-path PAY/STATUS) — YA NO ES UN CONTENEDOR: es una cuenta SFTP en la nube.
#
# Un servidor SFTP tiene equivalente gratuito gestionado, asi que dejo de operarse aqui. Lo que
# NO se puede contratar es el cerebro del banco: bank-sim sigue, hablando SFTP contra esta cuenta.
#
# LA CLAVE NO VA EN ESTE FICHERO NI EN .env. Va al vault, y la definicion de conexion la referencia
# como ${secret:tasks/sftp/bank/password} (QA-006). Aqui solo lo que no es secreto.
SFTP_BANK_HOST=eu-central-1.sftpcloud.io
SFTP_BANK_PORT=22
SFTP_BANK_USER=<usuario-de-la-cuenta-sftpcloud>
# La cuenta gratuita se recrea cada pocas horas: usuario y clave CAMBIAN. Si el money-path deja de
# entregar de golpe y sin haber tocado nada, es lo primero que hay que mirar.
#
# strictHostKeyChecking va en FALSE contra sftpcloud: la huella del host cambia con la cuenta, asi
# que fijarla en known_hosts no se sostiene. Es aceptable en integracion y NO debe viajar a
# produccion, donde el destino es el banco de verdad y la huella si es estable.
SFTP_BANK_STRICT_HOST_KEY_CHECKING=false

# Token con el que la APP lee secretos de OpenBao. NO el token raiz: uno acotado por la politica
# de int/openbao/policy-integration-hub.hcl (solo lectura de secret/connections/* y secret/tasks/*).
# El VALOR va en int/.env, que no se versiona. Aqui solo la clave, vacia.
OPENBAO_TOKEN=
