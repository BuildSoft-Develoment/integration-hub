# ===== Ambiente de integracion — copiar a .env y ajustar =====

# URL publica base (host que frontea nginx). El issuer de Keycloak y el OIDC de la app
# se derivan de aca. Para test local: dejar el default + agregar al hosts file:
#   127.0.0.1  app.buildsoft.com.pe
#
# TIENE QUE SER UN NOMBRE, NO `localhost` NI UNA IP, y el motivo es el SSO de OpenBao.
#
# OpenBao no se limita a redirigir el navegador a Keycloak: descubre la configuracion, canjea el
# codigo y baja las claves POR SU CUENTA, y exige que la URL que usa sea identica al `issuer` que
# Keycloak anuncia. Es decir, esta misma. Y `localhost` dentro de un contenedor es el propio
# contenedor, asi que OpenBao nunca alcanzaria a Keycloak por ahi.
#
# Con un nombre si funciona en los dos lados a la vez: el navegador lo resuelve por el hosts file
# (o por DNS en el servidor) y los contenedores por el alias de red que nginx tiene en ihnet.
# Una IP de LAN tampoco sirve: cambia al cambiar de red y se lleva el issuer por delante.
PUBLIC_BASE_URL=https://app.buildsoft.com.pe

# Puertos que nginx publica en el host, y que conf usa. El 443 es el unico que sale a Internet en
# el servidor; en local se mapea igual para que la URL sea LA MISMA en los dos sitios y lo que se
# prueba aqui sea lo que pasa alla. nginx escucha dentro en 443 y en 8443 (ver int/nginx/https.conf).
NGINX_PORTS=443:443
NGINX_CONF=./int/nginx/https.conf

# Imagenes de la app y del consumidor. DEBEN llevar /appih horneado (ver README > Build).
#
# DOS ORIGENES POSIBLES, Y NO DAN LO MISMO
#
# 1. Construidas aqui (lo de siempre): los valores de abajo, tal cual.
#
# 2. LAS QUE PUBLICO CI, descargadas del registro. Es lo que ADR-029 llama promocion de
#    artefacto, y sirve para ensayar en integracion EL MISMO binario que va a correr en la nube
#    —no uno equivalente compilado en otra maquina, que es lo que se hacia hasta ahora—:
#
#      docker login ghcr.io -u <usuario> --password-stdin   (token con read:packages)
#      APP_IMAGE=ghcr.io/buildsoft-develoment/integration-hub/platform-app:<tag>
#      CONSUMER_IMAGE=ghcr.io/buildsoft-develoment/integration-hub/audit-consumer:<tag>
#      docker compose -f docker-compose.int.yml --env-file int/.env pull platform-app audit-consumer
#
#    El <tag> es el mismo que despues ira al IMAGE_TAG de la VM. Si arranca aqui, arranca alli.
APP_IMAGE=integration-hub:native-appih
CONSUMER_IMAGE=integration-hub-audit-consumer:native

# Postgres
POSTGRES_PASSWORD=admin

# Keycloak admin (consola en http://app.buildsoft.com.pe/iam/admin)
KC_ADMIN_PASSWORD=admin

# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# SFTP fuente (SftpSourceProvider)
SFTP_SOURCE_USER=ihsource
SFTP_SOURCE_PASS=ihsource

# FTP fuente (FtpSourceProvider)
FTP_SOURCE_USER=ihftp
FTP_SOURCE_PASS=ihftp

# SFTP banco (money-path PAY/STATUS) — YA NO ES UN CONTENEDOR: es una cuenta SFTP en la nube.
#
# Un servidor SFTP tiene equivalente gratuito gestionado, asi que dejo de operarse aqui. Lo que
# NO se puede contratar es el cerebro del banco: bank-sim sigue, hablando SFTP contra esta cuenta.
#
# LA CLAVE NO VA EN ESTE FICHERO NI EN .env. Va al vault, y la definicion de conexion la referencia
# como ${secret:tasks/sftp/bank/password} (QA-006). Aqui solo lo que no es secreto.
SFTP_BANK_HOST=eu-central-1.sftpcloud.io
SFTP_BANK_PORT=22
SFTP_BANK_USER=<usuario-de-la-cuenta-sftpcloud>
# La cuenta gratuita se recrea cada pocas horas: usuario y clave CAMBIAN. Si el money-path deja de
# entregar de golpe y sin haber tocado nada, es lo primero que hay que mirar.
#
# strictHostKeyChecking va en FALSE contra sftpcloud: la huella del host cambia con la cuenta, asi
# que fijarla en known_hosts no se sostiene. Es aceptable en integracion y NO debe viajar a
# produccion, donde el destino es el banco de verdad y la huella si es estable.
SFTP_BANK_STRICT_HOST_KEY_CHECKING=false

# Token con el que la APP lee secretos de OpenBao. NO el token raiz: uno acotado por la politica
# de int/openbao/policy-integration-hub.hcl (solo lectura de secret/connections/* y secret/tasks/*).
# El VALOR va en int/.env, que no se versiona. Aqui solo la clave, vacia.
OPENBAO_TOKEN=

# Secreto del cliente `openbao` en Keycloak — el SSO de la consola de OpenBao.
#
# Un unico knob para los dos lados: Keycloak lo sustituye en el ${...} del realm al importarlo, y
# el mismo valor se le pasa a int/openbao/setup-oidc.sh. Si se desincronizan, el login falla al
# canjear el codigo con "invalid_client", que suena a cliente mal creado y es solo esto.
#
# Generar uno aleatorio, p.ej.:  openssl rand -base64 32
# El VALOR va en int/.env. Aqui solo la clave, vacia.
OPENBAO_OIDC_CLIENT_SECRET=
