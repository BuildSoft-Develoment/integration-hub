# ===== Ambiente de integracion — copiar a .env y ajustar =====

# URL publica base (host que frontea nginx). El issuer de Keycloak y el OIDC de la app
# se derivan de aca. Para test local: dejar el default + agregar al hosts file:
#   127.0.0.1  app.buildsoft.com.pe
PUBLIC_BASE_URL=http://app.buildsoft.com.pe

# Imagen de la app. DEBE estar construida con /appih horneado (ver README > Build).
APP_IMAGE=integration-hub:native-appih

# Postgres
POSTGRES_PASSWORD=admin

# Keycloak admin (consola en http://app.buildsoft.com.pe/iam/admin)
KC_ADMIN_PASSWORD=admin

# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# SFTP fuente (SftpSourceProvider)
SFTP_SOURCE_USER=ihsource
SFTP_SOURCE_PASS=ihsource

# FTP fuente (FtpSourceProvider)
FTP_SOURCE_USER=ihftp
FTP_SOURCE_PASS=ihftp

# SFTP banco (money-path PAY: inbox donde PAY sube el FIN MT101)
SFTP_BANK_USER=bank
SFTP_BANK_PASS=bank
