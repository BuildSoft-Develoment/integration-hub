# On-premise - variables. Los secretos vienen del file vault del proyecto
# (create-file-vault-secret.cmd) o HashiCorp Vault, inyectados por el orquestador.
QUARKUS_PROFILE=prod,onprem
DEPLOY_ENV=prod
APP_VERSION=0.0.1

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
PLUGIN_STAGING_BUCKET=remote-plugin-staging

DB_JDBC_URL=jdbc:postgresql://postgres:5432/integration_hub
OIDC_AUTH_SERVER_URL=http://keycloak:8080/realms/integration-hub
OIDC_CLIENT_ID=integration-hub-api
OTEL_OTLP_ENDPOINT=http://otel-collector:4317
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Controles bancarios MT101 (defaults SEGUROS ya fijados en application-prod.properties) ---
# Descomenta solo para override; en prod bancaria los valores por defecto ya son los correctos.
# MT101_MAKER_CHECKER_ENABLED=true          # four-eyes al reconocer PAY_CONFLICT (prod: true)
# MT101_DIRECT_LIST_ENABLED=false           # PAY solo con build_fragment persistido (prod: false)
# MT101_INSERT_BATCH_MAX_BYTES=200000       # anti-deadlock H7 a escala (evidenciado a 1M)
# MT101_REQUIRE_NORMAL_PAY_RESOLVER=false   # true solo si concilias PAY inline (no por scheduler)

# --- SECRETOS (NO en claro en repo): DB_USERNAME / DB_PASSWORD / OIDC_CLIENT_SECRET ---
DB_USERNAME=
DB_PASSWORD=
OIDC_CLIENT_SECRET=
