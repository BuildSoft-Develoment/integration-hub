specification {
  element person {
    notation 'Actor'
    style {
      shape person
      color amber
    }
  }
  element system {
    notation 'Sistema'
    style {
      color blue
    }
  }
  element container {
    notation 'Contenedor'
    style {
      color green
    }
  }
  element component {
    notation 'Componente'
    style {
      color blue
    }
  }
  deploymentNode environment {
    notation 'Environment'
    style {
      color gray
    }
  }
  deploymentNode docker {
    notation 'Docker Host'
    style {
      color green
    }
  }
  deploymentNode kubernetes {
    notation 'Kubernetes Cluster'
    style {
      color blue
    }
  }
  deploymentNode zone {
    notation 'Zone'
    style {
      color gray
    }
  }
  deploymentNode cluster {
    notation 'Cluster'
    style {
      color blue
    }
  }
  deploymentNode node {
    notation 'Node'
    style {
      color green
      multiple true
    }
  }
}

model {
  user = person 'Usuario de negocio'
  admin = person 'Administrador de integraciones'
  platformAdmin = person 'Platform Admin'
  integrationAdmin = person 'Integration Admin'
  operator = person 'Operator'
  auditor = person 'Auditor'
  infraTeam = person 'Equipo de infraestructura'
  schedulerActor = person 'Scheduler'

  externalApi = system 'APIs externas'
  externalDatabases = system 'External Databases' {
    container oracleDb 'Oracle 12-19'
    container postgresDb 'PostgreSQL'
    container sqlServerDb 'SQL Server'
    container mysqlDb 'MySQL'
    container mongoDb 'MongoDB (parcial: no implementado)'
  }
  iam = system 'Keycloak'
  db = system 'PostgreSQL'
  loadBalancer = system 'Load Balancer / Reverse Proxy'
  ingressController = system 'Ingress Controller'
  appService = system 'Integration Hub Service'
  vault = system 'Kubernetes Secrets / External Config'
  sharedStorage = system 'Shared File Storage'

  fileSources = system 'Fuentes externas' {
    container filesystem 'File System'
    container ftp 'FTP'
    container sftp 'SFTP'
    container restSource 'REST Source'
  }

  observability = system 'Observabilidad' {
    container otel 'OpenTelemetry Collector'
    container jaeger 'Jaeger'
  }

  integrationHub = system 'Integration Hub Platform' {
    container adminConsole 'Admin Console App (Front)' {
      component angularApp 'Angular 21 UI'
      component oidcClient 'OIDC Client'
      component processDesigner 'Process Designer'
      component operationsConsole 'Operations Console'
    }

    container quarkusApp 'App Service Quarkus Native' {
      component processDefinitionResource 'ProcessDefinitionResource'
      component sourceDefinitionResource 'SourceDefinitionResource'
      component readerDefinitionResource 'ReaderDefinitionResource'
      component processExecutionResource 'ProcessExecutionResource'
      component processScheduleResource 'ProcessScheduleResource'
      component executionQueryResource 'ExecutionQueryResource'
      component processCatalogService 'ProcessCatalogService'
      component sourceCatalogService 'SourceCatalogService'
      component readerCatalogService 'ReaderCatalogService'
      component processExecutionService 'ProcessExecutionService'
      component processScheduleQueryService 'ProcessScheduleQueryService'
      component executionQueryService 'ExecutionQueryService'
      component processSchedulerService 'ProcessSchedulerService'
      component processEngine 'Process Engine' {
        component jsonConfigurationMapper 'JsonConfigurationMapper'
        component sourceRegistry 'Source Provider Registry'
        component readerRegistry 'Reader Provider Registry'
        component taskRegistry 'Task Provider Registry'
        component sourceProviders 'Source Providers'
        component readerProviders 'Reader Providers'
        component taskProviders 'Task Providers' {
          component dbWriteTaskProvider 'DbWriteTaskProvider'
          component connectionRegistry 'Connection Registry'
          component connectionPoolManager 'Connection Pool Manager'
          component jdbcWriteExecutor 'Jdbc Write Executor'
          component mongoWriteExecutor 'Mongo Write Executor (no implementado)'
          component restCallTaskProvider 'RestCallTaskProvider'
          component notificationTaskProvider 'NotificationTaskProvider'
        }
      }
      component auditService 'Audit Service'
      component telemetry 'OpenTelemetry Instrumentation'
      component packages 'Package Structure' {
        component apiPackage 'api'
        component apiQueryPackage 'api.query'
        component servicePackage 'service'
        component repositoryPackage 'repository'
        component entityPackage 'entity'
        component spiPackage 'spi'
        component providerPackage 'provider' {
          component providerSourcePackage 'provider.source'
          component providerReaderPackage 'provider.reader'
          component providerTaskPackage 'provider.task'
        }
        component domainPackage 'domain'
      }
      component repositories 'Repositories' {
        component processDefinitionRepository 'ProcessDefinitionRepository'
        component sourceDefinitionRepository 'SourceDefinitionRepository'
        component readerDefinitionRepository 'ReaderDefinitionRepository'
        component processTaskDefinitionRepository 'ProcessTaskDefinitionRepository'
        component processExecutionRepository 'ProcessExecutionRepository'
        component processTaskExecutionRepository 'ProcessTaskExecutionRepository'
        component auditEventRepository 'AuditEventRepository'
      }
      component domainEntities 'Domain Entities' {
        component catalogEntities 'Catalog' {
          component sourceDefinitionEntity 'SourceDefinition'
          component readerDefinitionEntity 'ReaderDefinition'
          component processDefinitionEntity 'ProcessDefinition'
          component processTaskDefinitionEntity 'ProcessTaskDefinition'
        }
        component executionEntities 'Execution' {
          component processExecutionEntity 'ProcessExecution'
          component processTaskExecutionEntity 'ProcessTaskExecution'
          component auditEventEntity 'AuditEvent'
        }
      }
    }
  }

  user -> integrationHub.adminConsole 'Consulta estado y resultados'
  admin -> integrationHub.adminConsole 'Configura fuentes, readers y procesos'
  integrationAdmin -> integrationHub.adminConsole 'Administra catalogos y procesos'
  operator -> integrationHub.adminConsole 'Ejecuta procesos'
  auditor -> integrationHub.adminConsole 'Consulta auditoria y resultados'

  integrationHub.adminConsole -> iam 'Autenticacion OIDC'
  integrationHub.adminConsole -> integrationHub.quarkusApp 'Invoca APIs protegidas'

  integrationHub.quarkusApp -> iam 'Valida access tokens'
  integrationHub.quarkusApp -> db 'Persiste configuracion, jobs, auditoria y staging'
  integrationHub.quarkusApp -> fileSources.filesystem 'Lee archivos locales'
  integrationHub.quarkusApp -> fileSources.ftp 'Descarga archivos'
  integrationHub.quarkusApp -> fileSources.sftp 'Descarga archivos'
  integrationHub.quarkusApp -> fileSources.restSource 'Obtiene payloads remotos'
  integrationHub.quarkusApp -> externalApi 'Invoca APIs de negocio'
  integrationHub.quarkusApp -> externalDatabases 'Escribe a bases externas dinamicas'
  integrationHub.quarkusApp -> observability.otel 'Exporta trazas'
  observability.otel -> observability.jaeger 'Entrega trazas'

  integrationHub.adminConsole.angularApp -> integrationHub.adminConsole.oidcClient 'Gestiona sesion'
  integrationHub.adminConsole.angularApp -> integrationHub.adminConsole.processDesigner 'Configura catalogos y procesos'
  integrationHub.adminConsole.angularApp -> integrationHub.adminConsole.operationsConsole 'Consulta y ejecuta procesos'
  integrationHub.adminConsole.oidcClient -> iam 'Login y refresh token'
  integrationHub.adminConsole.processDesigner -> integrationHub.quarkusApp.processDefinitionResource 'CRUD de procesos'
  integrationHub.adminConsole.processDesigner -> integrationHub.quarkusApp.sourceDefinitionResource 'CRUD de sources'
  integrationHub.adminConsole.processDesigner -> integrationHub.quarkusApp.readerDefinitionResource 'CRUD de readers'
  integrationHub.adminConsole.operationsConsole -> integrationHub.quarkusApp.processExecutionResource 'Ejecuta procesos'
  integrationHub.adminConsole.operationsConsole -> integrationHub.quarkusApp.executionQueryResource 'Consulta ejecuciones y auditoria'
  integrationHub.adminConsole.operationsConsole -> integrationHub.quarkusApp.processScheduleResource 'Consulta programaciones'

  integrationHub.quarkusApp.processDefinitionResource -> integrationHub.quarkusApp.processCatalogService 'Delega gestion de procesos'
  integrationHub.quarkusApp.sourceDefinitionResource -> integrationHub.quarkusApp.sourceCatalogService 'Delega gestion de sources'
  integrationHub.quarkusApp.readerDefinitionResource -> integrationHub.quarkusApp.readerCatalogService 'Delega gestion de readers'
  integrationHub.quarkusApp.processExecutionResource -> integrationHub.quarkusApp.processExecutionService 'Delega ejecucion'
  integrationHub.quarkusApp.processScheduleResource -> integrationHub.quarkusApp.processScheduleQueryService 'Delega consulta de schedules'
  integrationHub.quarkusApp.executionQueryResource -> integrationHub.quarkusApp.executionQueryService 'Delega consultas operativas'

  integrationHub.quarkusApp.processCatalogService -> integrationHub.quarkusApp.repositories.processDefinitionRepository 'Persiste procesos'
  integrationHub.quarkusApp.processCatalogService -> integrationHub.quarkusApp.repositories.processTaskDefinitionRepository 'Persiste tasks'
  integrationHub.quarkusApp.processCatalogService -> integrationHub.quarkusApp.repositories.sourceDefinitionRepository 'Resuelve source definitions'
  integrationHub.quarkusApp.processCatalogService -> integrationHub.quarkusApp.repositories.readerDefinitionRepository 'Resuelve reader definitions'
  integrationHub.quarkusApp.sourceCatalogService -> integrationHub.quarkusApp.repositories.sourceDefinitionRepository 'Persiste sources'
  integrationHub.quarkusApp.readerCatalogService -> integrationHub.quarkusApp.repositories.readerDefinitionRepository 'Persiste readers'
  integrationHub.quarkusApp.processExecutionService -> integrationHub.quarkusApp.auditService 'Registra eventos'
  integrationHub.quarkusApp.processScheduleQueryService -> integrationHub.quarkusApp.repositories.processDefinitionRepository 'Consulta programaciones'
  integrationHub.quarkusApp.executionQueryService -> integrationHub.quarkusApp.repositories.processExecutionRepository 'Consulta ejecuciones'
  integrationHub.quarkusApp.executionQueryService -> integrationHub.quarkusApp.repositories.processTaskExecutionRepository 'Consulta tareas ejecutadas'
  integrationHub.quarkusApp.executionQueryService -> integrationHub.quarkusApp.repositories.auditEventRepository 'Consulta auditoria'
  integrationHub.quarkusApp.executionQueryService -> integrationHub.quarkusApp.repositories.sourceDefinitionRepository 'Cuenta sources'
  integrationHub.quarkusApp.executionQueryService -> integrationHub.quarkusApp.repositories.readerDefinitionRepository 'Cuenta readers'
  integrationHub.quarkusApp.executionQueryService -> integrationHub.quarkusApp.repositories.processDefinitionRepository 'Cuenta procesos'
  integrationHub.quarkusApp.processSchedulerService -> integrationHub.quarkusApp.processExecutionService 'Dispara procesos programados'

  integrationHub.quarkusApp.packages.apiPackage -> integrationHub.quarkusApp.packages.servicePackage 'Invoca servicios'
  integrationHub.quarkusApp.packages.apiPackage -> integrationHub.quarkusApp.packages.apiQueryPackage 'Expone DTOs y respuestas'
  integrationHub.quarkusApp.packages.apiQueryPackage -> integrationHub.quarkusApp.packages.servicePackage 'Consume consultas'
  integrationHub.quarkusApp.packages.servicePackage -> integrationHub.quarkusApp.packages.repositoryPackage 'Accede a persistencia'
  integrationHub.quarkusApp.packages.servicePackage -> integrationHub.quarkusApp.packages.spiPackage 'Orquesta contratos'
  integrationHub.quarkusApp.packages.servicePackage -> integrationHub.quarkusApp.packages.domainPackage 'Usa enums y tipos'
  integrationHub.quarkusApp.packages.repositoryPackage -> integrationHub.quarkusApp.packages.entityPackage 'Persiste entidades'
  integrationHub.quarkusApp.packages.providerPackage.providerSourcePackage -> integrationHub.quarkusApp.packages.spiPackage 'Implementa SourceProvider'
  integrationHub.quarkusApp.packages.providerPackage.providerReaderPackage -> integrationHub.quarkusApp.packages.spiPackage 'Implementa ReaderProvider'
  integrationHub.quarkusApp.packages.providerPackage.providerTaskPackage -> integrationHub.quarkusApp.packages.spiPackage 'Implementa TaskProvider'
  integrationHub.quarkusApp.packages.providerPackage.providerTaskPackage -> integrationHub.quarkusApp.packages.domainPackage 'Usa estados y tipos'
  integrationHub.quarkusApp.packages.providerPackage.providerTaskPackage -> integrationHub.quarkusApp.packages.repositoryPackage 'Colabora con persistencia'

  integrationHub.quarkusApp.processEngine.sourceRegistry -> integrationHub.quarkusApp.processEngine.sourceProviders 'Usa implementations'
  integrationHub.quarkusApp.processEngine.readerRegistry -> integrationHub.quarkusApp.processEngine.readerProviders 'Usa implementations'
  integrationHub.quarkusApp.processEngine.taskRegistry -> integrationHub.quarkusApp.processEngine.taskProviders 'Usa implementations'

  integrationHub.quarkusApp.processExecutionService -> integrationHub.quarkusApp.processEngine.jsonConfigurationMapper 'Lee configuracion JSON'
  integrationHub.quarkusApp.processExecutionService -> integrationHub.quarkusApp.processEngine.sourceRegistry 'Resuelve SourceProvider'
  integrationHub.quarkusApp.processExecutionService -> integrationHub.quarkusApp.processEngine.readerRegistry 'Resuelve ReaderProvider'
  integrationHub.quarkusApp.processExecutionService -> integrationHub.quarkusApp.processEngine.taskRegistry 'Resuelve TaskProvider'
  integrationHub.quarkusApp.processExecutionService -> integrationHub.quarkusApp.processEngine.taskProviders.dbWriteTaskProvider 'Ejecuta DB_WRITE'
  integrationHub.quarkusApp.processEngine.taskProviders.dbWriteTaskProvider -> integrationHub.quarkusApp.processEngine.taskProviders.connectionRegistry 'Resuelve connectionRef'
  integrationHub.quarkusApp.processEngine.taskProviders.connectionRegistry -> integrationHub.quarkusApp.processEngine.taskProviders.connectionPoolManager 'Obtiene pool JDBC'
  integrationHub.quarkusApp.processEngine.taskProviders.dbWriteTaskProvider -> integrationHub.quarkusApp.processEngine.taskProviders.jdbcWriteExecutor 'Escribe en motores relacionales'
  integrationHub.quarkusApp.processEngine.taskProviders.dbWriteTaskProvider -> integrationHub.quarkusApp.processEngine.taskProviders.mongoWriteExecutor 'Escribe en MongoDB (no implementado)'
  integrationHub.quarkusApp.processExecutionService -> integrationHub.quarkusApp.processEngine.taskProviders.restCallTaskProvider 'Ejecuta REST_CALL'
  integrationHub.quarkusApp.processExecutionService -> integrationHub.quarkusApp.processEngine.taskProviders.notificationTaskProvider 'Ejecuta NOTIFICATION'

  integrationHub.quarkusApp.repositories -> db 'Opera sobre PostgreSQL'
  integrationHub.quarkusApp.processEngine.taskProviders.dbWriteTaskProvider -> db 'Batch insert, update y upsert internos'
  integrationHub.quarkusApp.processEngine.taskProviders.connectionPoolManager -> externalDatabases.oracleDb 'Mantiene pool JDBC'
  integrationHub.quarkusApp.processEngine.taskProviders.connectionPoolManager -> externalDatabases.postgresDb 'Mantiene pool JDBC'
  integrationHub.quarkusApp.processEngine.taskProviders.connectionPoolManager -> externalDatabases.sqlServerDb 'Mantiene pool JDBC'
  integrationHub.quarkusApp.processEngine.taskProviders.connectionPoolManager -> externalDatabases.mysqlDb 'Mantiene pool JDBC'
  integrationHub.quarkusApp.processEngine.taskProviders.mongoWriteExecutor -> externalDatabases.mongoDb 'Escribe documentos'
  integrationHub.quarkusApp.processEngine.taskProviders.restCallTaskProvider -> externalApi 'Envia payloads'
  integrationHub.quarkusApp.processEngine.taskProviders.notificationTaskProvider -> externalApi 'Webhook y notificaciones'

  user -> loadBalancer 'Accede por HTTPS'
  admin -> loadBalancer 'Administra por HTTPS'
  loadBalancer -> ingressController 'Reenvia trafico al cluster'
  vault -> integrationHub.quarkusApp 'Entrega secretos y credenciales'
  sharedStorage -> integrationHub.quarkusApp 'Comparte archivos locales'

  schedulerActor -> integrationHub.quarkusApp.processSchedulerService 'UC-05'
  platformAdmin -> iam 'UC-09'

  integrationHub.quarkusApp.repositories.processDefinitionRepository -> integrationHub.quarkusApp.domainEntities.catalogEntities.processDefinitionEntity 'Lee y persiste'
  integrationHub.quarkusApp.repositories.processTaskDefinitionRepository -> integrationHub.quarkusApp.domainEntities.catalogEntities.processTaskDefinitionEntity 'Lee y persiste'
  integrationHub.quarkusApp.repositories.sourceDefinitionRepository -> integrationHub.quarkusApp.domainEntities.catalogEntities.sourceDefinitionEntity 'Lee y persiste'
  integrationHub.quarkusApp.repositories.readerDefinitionRepository -> integrationHub.quarkusApp.domainEntities.catalogEntities.readerDefinitionEntity 'Lee y persiste'
  integrationHub.quarkusApp.repositories.processExecutionRepository -> integrationHub.quarkusApp.domainEntities.executionEntities.processExecutionEntity 'Lee y persiste'
  integrationHub.quarkusApp.repositories.processTaskExecutionRepository -> integrationHub.quarkusApp.domainEntities.executionEntities.processTaskExecutionEntity 'Lee y persiste'
  integrationHub.quarkusApp.repositories.auditEventRepository -> integrationHub.quarkusApp.domainEntities.executionEntities.auditEventEntity 'Lee y persiste'

  integrationHub.quarkusApp.domainEntities.catalogEntities.processDefinitionEntity -> integrationHub.quarkusApp.domainEntities.catalogEntities.processTaskDefinitionEntity '0..n taskDefinitions'
  integrationHub.quarkusApp.domainEntities.catalogEntities.processDefinitionEntity -> integrationHub.quarkusApp.domainEntities.executionEntities.processExecutionEntity '0..n processExecutions'
  integrationHub.quarkusApp.domainEntities.catalogEntities.sourceDefinitionEntity -> integrationHub.quarkusApp.domainEntities.catalogEntities.processTaskDefinitionEntity '0..n taskDefinitions'
  integrationHub.quarkusApp.domainEntities.catalogEntities.readerDefinitionEntity -> integrationHub.quarkusApp.domainEntities.catalogEntities.processTaskDefinitionEntity '0..n taskDefinitions'
  integrationHub.quarkusApp.domainEntities.executionEntities.processExecutionEntity -> integrationHub.quarkusApp.domainEntities.executionEntities.processTaskExecutionEntity '0..n taskExecutions'
  integrationHub.quarkusApp.domainEntities.catalogEntities.processTaskDefinitionEntity -> integrationHub.quarkusApp.domainEntities.executionEntities.processTaskExecutionEntity '0..n taskExecutions'
  integrationHub.quarkusApp.domainEntities.executionEntities.processExecutionEntity -> integrationHub.quarkusApp.domainEntities.executionEntities.auditEventEntity '0..n auditEvents'
  integrationHub.quarkusApp.domainEntities.catalogEntities.processTaskDefinitionEntity -> integrationHub.quarkusApp.domainEntities.executionEntities.auditEventEntity '0..n auditEvents'}

deployment {
  environment dev {
    zone app {
      docker dockerHost {
        instanceOf integrationHub.adminConsole
        instanceOf integrationHub.quarkusApp
      }
    }
    zone data {
      node data {
        instanceOf db
        instanceOf iam
        instanceOf observability.otel
        instanceOf observability.jaeger
      }
    }
  }

  environment pre {
    zone app {
      node preNode1 {
        instanceOf integrationHub.adminConsole
        instanceOf integrationHub.quarkusApp
      }
    }
    zone data {
      node data {
        instanceOf db
        instanceOf iam
        instanceOf observability.otel
        instanceOf observability.jaeger
      }
    }
    zone services {
      node configNode {
        instanceOf vault
        instanceOf sharedStorage
      }
    }
  }

  environment prod {
    zone edge {
      node loadBalancer {
        instanceOf loadBalancer
      }
    }
    zone app {
      kubernetes appCluster {
        node ingressController {
          instanceOf ingressController
        }
        node appService {
          instanceOf appService
        }
        node appPod1 {
          instanceOf integrationHub.adminConsole
          instanceOf integrationHub.quarkusApp
        }
        node appPod2 {
          instanceOf integrationHub.adminConsole
          instanceOf integrationHub.quarkusApp
        }
      }
    }
    zone data {
      cluster postgresHa {
        node postgresPrimary {
          instanceOf db
        }
        node postgresReplica {
          instanceOf db
        }
      }
      cluster keycloakHa {
        node keycloakNode1 {
          instanceOf iam
        }
        node keycloakNode2 {
          instanceOf iam
        }
      }
      node observabilityNode {
        instanceOf observability.otel
        instanceOf observability.jaeger
      }
    }
    zone services {
      node servicesNode {
        instanceOf vault
        instanceOf sharedStorage
      }
    }

    loadBalancer -> ingressController 'HTTPS'
    ingressController -> appService 'Ruta UI y API'
    appService -> appPod1 'Balancea trafico HTTP'
    appService -> appPod2 'Balancea trafico HTTP'
  }
}

views 'Architecture' {
  style fileSources.* {
    color green
  }

  style observability.* {
    color gray
  }

  style externalDatabases.* {
    color green
  }

  style iam {
    color red
  }

  style db {
    color green
  }

  style loadBalancer {
    color gray
  }

  style ingressController {
    color gray
  }

  style appService {
    color gray
  }

  style vault {
    color gray
  }

  style sharedStorage {
    color gray
  }

  style integrationHub.quarkusApp.domainEntities {
    color indigo
  }

  style integrationHub.quarkusApp.domainEntities.catalogEntities.* {
    color indigo
  }

  style integrationHub.quarkusApp.domainEntities.executionEntities.* {
    color indigo
  }

  view context of integrationHub {
    title '01 Context / Usuario y ecosistema externo'
    include user
    include admin
    include integrationHub
    include iam
    include fileSources
    include externalApi
    include observability
  }

  view containers of integrationHub {
    title '02 Containers / Zoom a la plataforma'
    include integrationHub
    include integrationHub.*
    include user
    include admin
    include integrationAdmin
    include operator
    include auditor
    include iam
    include db
    include fileSources
    include fileSources.*
    include externalApi
    include observability
    include observability.*
  }

  view frontend_components of integrationHub.adminConsole {
    title '03 Components / Zoom a Admin Console App (Front)'
    include user
    include admin
    include integrationAdmin
    include operator
    include auditor
    include integrationHub
    include integrationHub.adminConsole
    include integrationHub.adminConsole.*
    include integrationHub.quarkusApp
    include db
    include iam
    include integrationHub.quarkusApp.processDefinitionResource
    include integrationHub.quarkusApp.sourceDefinitionResource
    include integrationHub.quarkusApp.readerDefinitionResource
    include integrationHub.quarkusApp.processExecutionResource
    include integrationHub.quarkusApp.processScheduleResource
    include integrationHub.quarkusApp.executionQueryResource
  }

  view backend_components of integrationHub.quarkusApp {
    title '03 Components / Zoom a App Service Quarkus Native'
    include user
    include admin
    include integrationAdmin
    include operator
    include auditor
    include integrationHub
    include integrationHub.quarkusApp
    include integrationHub.quarkusApp.*
    include integrationHub.adminConsole
    include db
    include iam
    include fileSources
    include fileSources.*
    include externalApi
    include observability
    include observability.*
  }

  view process_engine_code of integrationHub.quarkusApp.processEngine {
    title '04 Code / Zoom a Process Engine'
    include user
    include admin
    include integrationAdmin
    include operator
    include auditor
    include integrationHub
    include integrationHub.adminConsole
    include integrationHub.adminConsole.processDesigner
    include integrationHub.adminConsole.operationsConsole
    include integrationHub.quarkusApp
    include integrationHub.quarkusApp.processExecutionResource
    include integrationHub.quarkusApp.processExecutionService
    include integrationHub.quarkusApp.processEngine
    include integrationHub.quarkusApp.processEngine.*
    include integrationHub.quarkusApp.auditService
    include integrationHub.quarkusApp.telemetry
    include integrationHub.quarkusApp.repositories
    include integrationHub.quarkusApp.repositories.*
    include db
    include fileSources
    include fileSources.*
    include externalApi
    include observability
    include observability.*
  }

  view package_structure_code of integrationHub.quarkusApp.packages {
    title '04 Code / Package Structure'
    include integrationHub.quarkusApp
    include integrationHub.quarkusApp.packages
    include integrationHub.quarkusApp.packages.*
    include integrationHub.quarkusApp.packages.providerPackage.*
  }

  view domain_entities_code of integrationHub.quarkusApp.domainEntities {
    title '04 Code / Domain Entities'
    include integrationHub.quarkusApp
    include integrationHub.quarkusApp.domainEntities
    include integrationHub.quarkusApp.domainEntities.catalogEntities
    include integrationHub.quarkusApp.domainEntities.catalogEntities.*
    include integrationHub.quarkusApp.domainEntities.executionEntities
    include integrationHub.quarkusApp.domainEntities.executionEntities.*
    include db
  }

  view security_overview of integrationHub {
    title '05 Security / OIDC, roles y control de acceso'
    include user
    include admin
    include platformAdmin
    include integrationAdmin
    include operator
    include auditor
    include integrationHub.adminConsole
    include integrationHub.adminConsole.oidcClient
    include integrationHub.quarkusApp
    include integrationHub.quarkusApp.processDefinitionResource
    include integrationHub.quarkusApp.processExecutionResource
    include iam
  }

  deployment view deployment_dev {
    title '10 Deployment / DEV'
    include dev.**
  }

  deployment view deployment_pre {
    title '10 Deployment / PRE'
    include pre.**
  }

  deployment view deployment_prod {
    title '10 Deployment / PROD'
    include prod.**
  }

  dynamic view usecase_uc01_source {
    title '11 Use Cases / UC-01 Configurar fuente'
    integrationAdmin -> integrationHub.adminConsole.processDesigner 'Define tipo de fuente y parametros'
    integrationHub.adminConsole.processDesigner -> integrationHub.quarkusApp.sourceDefinitionResource 'Registra source definition'
    integrationHub.quarkusApp.sourceDefinitionResource -> integrationHub.quarkusApp.sourceCatalogService 'Delega alta de catalogo'
    integrationHub.quarkusApp.sourceCatalogService -> integrationHub.quarkusApp.repositories.sourceDefinitionRepository 'Persiste source definition'
    integrationHub.quarkusApp.repositories.sourceDefinitionRepository -> db 'Guarda source definition'
    include integrationAdmin
    include integrationHub.adminConsole.processDesigner
    include integrationHub.quarkusApp.sourceDefinitionResource
    include integrationHub.quarkusApp.sourceCatalogService
    include integrationHub.quarkusApp.repositories.sourceDefinitionRepository
    include db
  }

  dynamic view usecase_uc02_reader {
    title '11 Use Cases / UC-02 Configurar reader'
    integrationAdmin -> integrationHub.adminConsole.processDesigner 'Define formato y layout'
    integrationHub.adminConsole.processDesigner -> integrationHub.quarkusApp.readerDefinitionResource 'Registra reader definition'
    integrationHub.quarkusApp.readerDefinitionResource -> integrationHub.quarkusApp.readerCatalogService 'Delega alta de catalogo'
    integrationHub.quarkusApp.readerCatalogService -> integrationHub.quarkusApp.repositories.readerDefinitionRepository 'Persiste reader definition'
    integrationHub.quarkusApp.repositories.readerDefinitionRepository -> db 'Guarda reader definition'
    include integrationAdmin
    include integrationHub.adminConsole.processDesigner
    include integrationHub.quarkusApp.readerDefinitionResource
    include integrationHub.quarkusApp.readerCatalogService
    include integrationHub.quarkusApp.repositories.readerDefinitionRepository
    include db
  }

  dynamic view usecase_uc03_process {
    title '11 Use Cases / UC-03 Disenar proceso'
    integrationAdmin -> integrationHub.adminConsole.processDesigner 'Crea proceso y ordena tareas'
    integrationHub.adminConsole.processDesigner -> integrationHub.quarkusApp.processDefinitionResource 'Guarda process definition'
    integrationHub.quarkusApp.processDefinitionResource -> integrationHub.quarkusApp.processCatalogService 'Valida y registra tareas'
    integrationHub.quarkusApp.processCatalogService -> integrationHub.quarkusApp.repositories.processDefinitionRepository 'Persiste definicion'
    integrationHub.quarkusApp.processCatalogService -> integrationHub.quarkusApp.repositories.processTaskDefinitionRepository 'Persiste tasks'
    integrationHub.quarkusApp.repositories.processDefinitionRepository -> db 'Guarda process definition'
    integrationHub.quarkusApp.repositories.processTaskDefinitionRepository -> db 'Guarda process tasks'
    include integrationAdmin
    include integrationHub.adminConsole.processDesigner
    include integrationHub.quarkusApp.readerDefinitionResource
    include integrationHub.quarkusApp.readerCatalogService
    include integrationHub.quarkusApp.repositories.readerDefinitionRepository
    include db
  }

  dynamic view usecase_uc04_manual_execution {
    title '11 Use Cases / UC-04 Ejecutar proceso manualmente'
    operator -> integrationHub.adminConsole.operationsConsole 'Selecciona proceso activo'
    integrationHub.adminConsole.operationsConsole -> integrationHub.quarkusApp.processExecutionResource 'Solicita ejecucion'
    integrationHub.quarkusApp.processExecutionResource -> integrationHub.quarkusApp.processExecutionService 'Delega ejecucion'
    integrationHub.quarkusApp.processExecutionService -> integrationHub.quarkusApp.processEngine.taskProviders.dbWriteTaskProvider 'Persiste registros'
