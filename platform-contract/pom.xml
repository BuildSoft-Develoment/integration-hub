<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.integrationhub</groupId>
        <artifactId>integration-hub-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>platform-contract</artifactId>
    <name>platform-contract</name>
    <description>
        Contrato compartido entre el productor (platform-app) y el consumidor
        (audit-consumer): SPI de mensajeria broker-agnostico y la trama de
        auditoria (AuditEnvelope). Java puro, sin extensiones Quarkus, para que
        ambos deployables dependan de el sin arrastrar runtime.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
